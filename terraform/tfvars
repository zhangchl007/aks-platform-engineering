# Sample tfvars - rename to terraform.tfvars to use

# Azure region
location = "westus3"

# Kubernetes version
kubernetes_version = null # Defaults to latest

# GitOps Addons configuration
gitops_addons_org      = "https://github.com/myGitHubUserName"
gitops_addons_repo     = "aks-platform-engineering"
gitops_addons_basepath = "gitops/"
gitops_addons_path     = "bootstrap/control-plane/addons"
gitops_addons_revision = "main"

# Agents size
agents_size = "Standard_D4as_v6"

# Addons configuration
addons = {
  enable_kyverno                         = false
}

# Resource group name
resource_group_name = "aks-gitops"

# VM-hosted kind clusters that are visible through Azure Arc. Each entry is
# created by the reusable terraform/modules/arc-kind-vm module. An empty map
# disables VM-hosted kind cluster infrastructure.
arc_kind_vms = {
  arc-kind-vm = {
    cluster_name   = "arc-demo-vm"
    size           = "Standard_D4as_v6"
    admin_username = "azureuser"
    api_port       = 6443
  }
  arc-kind-vm-2 = {
    cluster_name   = "arc-demo-vm-2"
    size           = "Standard_D4as_v6"
    admin_username = "azureuser"
    api_port       = 6443
  }
}
