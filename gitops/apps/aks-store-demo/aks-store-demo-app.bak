apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: aks-store-demo
  namespace: argocd
  annotations:
    backstage.io/kubernetes-id: aks-store-demo
    argocd.argoproj.io/sync-wave: "1"
spec:
  project: default
  source:
    repoURL: https://github.com/Azure-Samples/aks-store-demo.git
    targetRevision: HEAD
    path: kustomize/overlays/dev
    kustomize:
      patches:
        # The upstream dev overlay caps documentdb (Postgres 17 + DocumentDB) at
        # cpu=25m, which throttles first-boot initdb so hard it never becomes ready
        # and crash-loops. Give it enough CPU/memory to finish initialization.
        - target:
            kind: StatefulSet
            name: documentdb
          patch: |-
            - op: replace
              path: /spec/template/spec/containers/0/resources/limits/cpu
              value: "1000m"
            - op: replace
              path: /spec/template/spec/containers/0/resources/requests/cpu
              value: "250m"
            - op: replace
              path: /spec/template/spec/containers/0/resources/limits/memory
              value: "2Gi"
            - op: replace
              path: /spec/template/spec/containers/0/resources/requests/memory
              value: "512Mi"
  destination:
    name: aks-customer-demo
    namespace: aks-store-demo
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
